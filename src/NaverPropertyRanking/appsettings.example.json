{
  "Api": {
    "BaseUrl": "https://new.land.naver.com",
    "RealtorArticleList": {
      "Endpoint": "/api/articles",
      "RealtorIdParameter": "realtorId",
      "Headers": {
        "Authorization": "Bearer REALTOR_LIST_TOKEN",
        "Referer": "https://new.land.naver.com/",
        "Cookie": "REALTOR_LIST_COOKIE"
      },
      "Params": {
        "realEstateType": "",
        "tradeType": "",
        "order": "rank",
        "page": "1",
        "zoom": "0"
      }
    },
    "Ranking": {
      "Endpoint": "/api/articles",
      "Headers": {
        "Authorization": "Bearer RANKING_TOKEN",
        "Referer": "https://new.land.naver.com/",
        "Cookie": "RANKING_COOKIE"
      },
      "Params": {
        "index": "1"
      }
    },
    "ArticleDetail": {
      "Endpoint": "/api/articles/{articleNo}",
      "Headers": {
        "Authorization": "Bearer ARTICLE_DETAIL_TOKEN",
        "Referer": "https://new.land.naver.com/",
        "Cookie": "ARTICLE_DETAIL_COOKIE"
      },
      "Params": {}
    },
    "ComplexDetail": {
      "Endpoint": "/api/complexes/{complexNo}",
      "Headers": {
        "Authorization": "Bearer COMPLEX_DETAIL_TOKEN",
        "Referer": "https://new.land.naver.com/",
        "Cookie": "COMPLEX_DETAIL_COOKIE"
      },
      "Params": {}
    },
    "RealtorAdvertisement": {
      "Endpoint": "https://fin.land.naver.com/front-api/v1/realtor/advertisement",
      "Headers": {
        "Referer": "https://fin.land.naver.com/",
        "Cookie": "FIN_LAND_COOKIE"
      },
      "Params": {
        "advertisementRerankChannelType": "property.complex.price",
        "tradeTypes[]": "A1"
      }
    },
    "ComplexAdvertising": {
      "Endpoint": "/api/articles/complex/{complexNo}",
      "Headers": {
        "Authorization": "Bearer COMPLEX_AD_TOKEN",
        "Referer": "https://new.land.naver.com/",
        "Cookie": "COMPLEX_AD_COOKIE"
      },
      "Params": {
        "realEstateType": "APT:ABYG:JGC:PRE",
        "tradeType": "",
        "priceType": "RETAIL",
        "page": "1",
        "order": "rank",
        "showArticle": "false",
        "sameAddressGroup": "false",
        "type": "list"
      }
    }
  },
  "GoogleAuthentication": {
    "Enabled": false,
    "WebAppUrl": "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec",
    "PublicIpEndpoint": "https://api.ipify.org",
    "RequestTimeoutSeconds": 60,
    "HeartbeatIntervalSeconds": 120
  },
  "Update": {
    "Enabled": false,
    "CheckOnStartup": true,
    "CurrentVersion": "1.2.6",
    "ReleasesApiUrl": "https://api.github.com/repos/OWNER/REPOSITORY/releases?per_page=100",
    "ReleaseTagPrefix": "NaverPropertyRanking-v",
    "ReleasesPageUrl": "https://github.com/OWNER/REPOSITORY/releases",
    "AssetName": "NaverPropertyRanking.exe"
  }
}
